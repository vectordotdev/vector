data_dir: '@DATA_DIR@'
transforms:
  passthrough:
    type: remap
    inputs: []
    source: '.name = .name'
tests:
  - name: metric input survives a remap
    inputs:
      - insert_at: passthrough
        type: metric
        metric:
          name: count
          kind: absolute
          tags:
            message: test filter 1
          counter:
            value: 1
    outputs:
      - extract_from: passthrough
        expected_event_count: 1
        conditions:
          - type: vrl
            source: '.name == "count" && .kind == "absolute" && .tags.message == "test filter 1"'
