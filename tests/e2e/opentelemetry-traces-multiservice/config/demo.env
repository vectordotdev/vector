# Override the downloaded upstream .env without modifying it.
DEMO_VERSION=3.1.0
OTEL_RESOURCE_ATTRIBUTES=service.namespace=opentelemetry-demo,service.version=3.1.0

# One headless shopper, talking directly to the frontend instead of the web proxy.
LOCUST_AUTOSTART=false
LOCUST_HEADLESS=true
LOCUST_HOST=http://frontend:8080
LOCUST_USERS=1
