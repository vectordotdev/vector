{
  "compilerOptions": {
    "target": "esnext",
    "module": "es2022",
    "jsx": "react",
    "lib": ["dom", "es2015", "es2017"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "typeRoots": ["./node_modules/@types"]
  },
  "exclude": ["node_modules"],
  "include": ["**/*.ts", "assets/js/search.tsx"]
}
