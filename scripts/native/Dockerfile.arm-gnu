ARG BASE=debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
FROM ${BASE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash build-essential ca-certificates clang cmake curl git libclang-dev \
    libprotobuf-dev libsasl2-dev libssl-dev perl pkg-config protobuf-compiler unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG RUST_VERSION
ARG RUST_HOST
ARG RUST_TARGET
ENV CARGO_HOME=/opt/cargo
ENV PATH="/opt/rust/bin:${PATH}"
# ARMv6 host tools stall, and ARMv7 rustc runs out of 32-bit address space with
# the release feature set. Cross-compile ARM32 with native ARM64 host tools,
# without cross-rs or emulated build tools. Install target libraries for both
# linking and execution through the runner kernel's native ARM32 support.
RUN set -eu; \
    case "${RUST_TARGET}" in \
      arm-unknown-linux-gnueabi) arch=armel; triple=arm-linux-gnueabi ;; \
      armv7-unknown-linux-gnueabihf) arch=armhf; triple=arm-linux-gnueabihf ;; \
      *) arch= ;; \
    esac; \
    if [ -n "${arch}" ] && [ "${RUST_TARGET}" != "${RUST_HOST}" ]; then \
      dpkg --add-architecture "${arch}" \
      && apt-get update \
      && apt-get install -y --no-install-recommends \
        "gcc-${triple}" "g++-${triple}" \
        "libc6-dev:${arch}" "libgcc-s1:${arch}" "libstdc++6:${arch}" \
        "libsasl2-dev:${arch}" "libssl-dev:${arch}" "zlib1g-dev:${arch}" \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# Verify and install upstream Rust archives without relying on rustup at runtime.
RUN set -eux; \
    cd /tmp; \
    set -- "rustc-${RUST_VERSION}-${RUST_HOST}" \
      "cargo-${RUST_VERSION}-${RUST_HOST}" "rust-std-${RUST_VERSION}-${RUST_HOST}"; \
    if [ "${RUST_TARGET}" != "${RUST_HOST}" ]; then \
      case "${RUST_TARGET}" in \
        *-gnueabi|*-gnueabihf) set -- "$@" "rust-std-${RUST_VERSION}-${RUST_TARGET}" ;; \
      esac; \
    fi; \
    for component; do \
      archive="${component}.tar.xz"; \
      curl --retry 5 --connect-timeout 30 --max-time 180 -fsSLO "https://static.rust-lang.org/dist/${archive}"; \
      curl --retry 5 --connect-timeout 30 --max-time 180 -fsSLO "https://static.rust-lang.org/dist/${archive}.sha256"; \
      sha256sum -c "${archive}.sha256"; \
      tar -xJf "${archive}"; \
      "./${archive%.tar.xz}/install.sh" --prefix=/opt/rust --disable-ldconfig; \
      rm -rf "/tmp/${archive}" "/tmp/${archive}.sha256" "/tmp/${archive%.tar.xz}"; \
    done

ENV CC_arm_unknown_linux_gnueabi=arm-linux-gnueabi-gcc \
    CXX_arm_unknown_linux_gnueabi=arm-linux-gnueabi-g++ \
    AR_arm_unknown_linux_gnueabi=arm-linux-gnueabi-ar \
    CARGO_TARGET_ARM_UNKNOWN_LINUX_GNUEABI_LINKER=arm-linux-gnueabi-gcc \
    PKG_CONFIG_ALLOW_CROSS_arm_unknown_linux_gnueabi=1 \
    PKG_CONFIG_LIBDIR_arm_unknown_linux_gnueabi=/usr/lib/arm-linux-gnueabi/pkgconfig
ENV CC_armv7_unknown_linux_gnueabihf=arm-linux-gnueabihf-gcc \
    CXX_armv7_unknown_linux_gnueabihf=arm-linux-gnueabihf-g++ \
    AR_armv7_unknown_linux_gnueabihf=arm-linux-gnueabihf-ar \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc \
    PKG_CONFIG_ALLOW_CROSS_armv7_unknown_linux_gnueabihf=1 \
    PKG_CONFIG_LIBDIR_armv7_unknown_linux_gnueabihf=/usr/lib/arm-linux-gnueabihf/pkgconfig
ENV PROTOC=/usr/bin/protoc
ENV CARGO_INCREMENTAL=0
WORKDIR /work
