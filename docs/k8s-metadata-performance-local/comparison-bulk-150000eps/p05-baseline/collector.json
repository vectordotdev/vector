{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "vector",
        "namespace": "vrl-kind-ab"
      },
      "data": {
        "vector.yaml": "data_dir: /vector-data\nsources:\n  logs:\n    type: kubernetes_logs\n    self_node_name: ${VECTOR_SELF_NODE_NAME}\n    extra_label_selector: benchmark=vrl-kind-ab\n    max_read_bytes: 20480\n    glob_minimum_cooldown_ms: 1000\n  vector_metrics:\n    type: internal_metrics\n    scrape_interval_secs: 1\nsinks:\n  discard:\n    type: blackhole\n    inputs: [logs]\n  metrics:\n    type: prometheus_exporter\n    inputs: [vector_metrics]\n    address: 0.0.0.0:9598\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "vector",
        "namespace": "vrl-kind-ab",
        "labels": {
          "app": "vector"
        }
      },
      "spec": {
        "serviceAccountName": "vector",
        "restartPolicy": "Never",
        "tolerations": [
          {
            "operator": "Exists"
          }
        ],
        "containers": [
          {
            "name": "vector",
            "image": "localhost/vector-vrl2044:baseline-ae18932a-minimal-musl",
            "args": [
              "--config",
              "/etc/vector/vector.yaml"
            ],
            "env": [
              {
                "name": "VECTOR_SELF_NODE_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "spec.nodeName"
                  }
                }
              }
            ],
            "ports": [
              {
                "containerPort": 9598
              }
            ],
            "resources": {
              "requests": {
                "cpu": "250m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            },
            "readinessProbe": {
              "tcpSocket": {
                "port": 9598
              },
              "initialDelaySeconds": 3,
              "periodSeconds": 2
            },
            "volumeMounts": [
              {
                "name": "config",
                "mountPath": "/etc/vector",
                "readOnly": true
              },
              {
                "name": "logs",
                "mountPath": "/var/log",
                "readOnly": true
              },
              {
                "name": "data",
                "mountPath": "/vector-data"
              }
            ],
            "imagePullPolicy": "Never"
          }
        ],
        "volumes": [
          {
            "name": "config",
            "configMap": {
              "name": "vector"
            }
          },
          {
            "name": "logs",
            "hostPath": {
              "path": "/var/log",
              "type": "Directory"
            }
          },
          {
            "name": "data",
            "emptyDir": {}
          }
        ]
      }
    }
  ]
}