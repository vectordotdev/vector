            "operator": "Exists"
          }
        ],
        "containers": [
          {
            "name": "generator",
            "image": "python:3.12-alpine",
            "command": [
              "python",
              "/work/generate.py"
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "32Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "128Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "script",
                "mountPath": "/work",
                "readOnly": true
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "script",
            "configMap": {
              "name": "generator"
            }
          }
        ]
      }
