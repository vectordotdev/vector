{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "generator",
        "namespace": "vrl-kind-ab"
      },
      "data": {
        "generate.py": "import time,sys,json,os\ntime.sleep(20)\nstart=time.monotonic()\ncount=0\nwhile time.monotonic()-start < 120:\n    target=start+count/75000\n    wait=target-time.monotonic()\n    if wait>0: time.sleep(wait)\n    batch=''.join(json.dumps(dict(pod=os.environ['HOSTNAME'],seq=count+i,payload='x'*128),separators=(',',':'))+'\\n' for i in range(100))\n    sys.stdout.write(batch)\n    sys.stdout.flush()\n    count+=100\nprint(json.dumps(dict(summary=True,events=count,seconds=time.monotonic()-start)),file=sys.stderr,flush=True)\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Pod",
      "metadata": {
        "name": "generator-0",
        "namespace": "vrl-kind-ab",
        "labels": {
