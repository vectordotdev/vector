#!/bin/sh
set -e

VECTOR_CONF=/etc/vector/vector.yaml
VECTOR_CONF_BACKUP=/etc/vector/.vector.yaml.pre-conffile

# If the install or upgrade is abandoned after preinst moved an unowned
# vector.yaml aside, put it back rather than leaving it hidden.
case "$1" in
  abort-install|abort-upgrade)
    if [ -e "$VECTOR_CONF_BACKUP" ]; then
      mv -f "$VECTOR_CONF_BACKUP" "$VECTOR_CONF"
    fi
    ;;
esac

# The bundled sample configs moved from /etc/vector/examples/ (where dpkg
# tracked them as conffiles) to /usr/share/vector/examples/. Remove the old
# copies on upgrade; dpkg-maintscript-helper deletes unmodified ones and renames
# locally modified ones to <file>.dpkg-bak. 0.59.0~ sorts before the first
# release that no longer ships them.
for f in \
    docs_example.yaml \
    environment_variables.yaml \
    es_s3_hybrid.yaml \
    file_to_cloudwatch_metrics.yaml \
    file_to_prometheus.yaml \
    http_sink_custom_retry.yaml \
    prometheus_to_console.yaml \
    stdio.yaml \
    varint_framing_protobuf.yaml \
    wrapped_json.yaml; do
  dpkg-maintscript-helper rm_conffile "/etc/vector/examples/$f" 0.59.0~ vector -- "$@"
done

#DEBHELPER#
